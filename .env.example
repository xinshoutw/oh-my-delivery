ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://omd:omd@localhost:5432/omd

# 32+ char random strings; rotate before going to prod.
SERVER_SECRET=change-me-to-a-32-char-secret-min-len
JWT_SECRET=change-me-too-for-jwt-32-char-min-len

JWT_ACCESS_TTL_MINUTES=720

DEPOSIT_BASE_AMOUNT=200
DEPOSIT_STEP_AMOUNT=100
DEPOSIT_MAX_LEVEL=3
DEPOSIT_DUE_DAYS=31
REWARD_WINDOW_DAYS=14
REWARD_POINTS_PER_RETURN=5
DEPOSIT_RESET_NO_OVERDUE_DAYS=90

PIN_MAX_ATTEMPTS=5
PIN_COOLDOWN_MINUTES=10
PIN_TTL_MINUTES=1440

PICKUP_SESSION_TTL_SECONDS=300
RETURN_SESSION_TTL_SECONDS=60
